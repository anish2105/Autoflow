# ==============================================================================
# AutoFlow Backend Environment Variables (.env.example)
# Duplicate this file to '.env' and fill in your actual credentials.
# Never commit real credentials or your '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Models & Keys
# Obtain your key from: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2
VALIDATOR_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Search & Document Extraction Tools
# ------------------------------------------------------------------------------
# Tavily Live Web Search (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl Web Scraper & Reader (https://www.firecrawl.dev/)
Firecrawl_API_KEY=your_firecrawl_api_key_here

# LlamaCloud for Agentic PDF OCR & Page Parsing (https://cloud.llamaindex.ai/)
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# ------------------------------------------------------------------------------
# 3. Supabase Database & Authentication
# Obtain from: https://supabase.com/dashboard/project/<id>/settings/api
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Note: Backend requires the service_role key to manage user tiers, quotas, and admin operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# JWT Secret found in: Project Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Optional fallback: comma-separated list of super admin Ace emails
# (Super Admin Ace is primarily assigned via the DB migration 005_user_roles_and_quotas.sql)
ACE_EMAILS=owner@example.com

# ------------------------------------------------------------------------------
# 4. Pinecone Vector Database (Hybrid Document RAG)
# Obtain from: https://app.pinecone.io/
# ------------------------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=autoflow-docs
PINECONE_ENVIRONMENT=
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 5. Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=False
