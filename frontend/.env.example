# ========================================================
# AutoFlow Frontend Environment Variables (.env.example)
# ========================================================

# Supabase Authentication & Realtime
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Base URL
# - In local development: leave empty or comment out (Vite proxy forwards /api to localhost:8000)
# - In Vercel production: set to your deployed Render URL (e.g., https://autoflow-backend.onrender.com)
VITE_API_BASE=

