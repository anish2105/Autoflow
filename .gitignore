# ==========================================
# AutoFlow .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env

# Python byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite & Database storage
*.db
*.sqlite
*.sqlite3
db/workflows_store.json

# Node & Frontend dependencies
frontend/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
frontend/.vite/
.vite/

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs & scratch files
*.log
scratch/
